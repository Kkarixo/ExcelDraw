      "text": "Figaf captures real message data.\nRuns automated tests on migrated scenarios.\nCompares old vs new behavior.\nShows easy-to-understand results.\nHelps maintain quality during and after migration.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Figaf captures real message data.\nRuns automated tests on migrated scenarios.\nCompares old vs new behavior.\nShows easy-to-understand results.\nHelps maintain quality during and after migration.",
      "autoResize": true,
      "lineHeight": 1.25
    },
